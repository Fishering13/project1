execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "variant_29 failed: ${status}")
endif()
foreach(expected "Count: 10" "Average: 132.70" "Total: 1327" "Minimum: 119" "Maximum: 147" "Median: 133.00")
    string(FIND "${output}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing ${expected} in ${output}")
    endif()
endforeach()
message(STATUS "Variant 29: all expected results verified")
