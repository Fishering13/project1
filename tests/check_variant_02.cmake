execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "variant_02 failed: ${status}")
endif()
foreach(expected "Count: 10" "Average: 80.20" "Maximum: 95" "Minimum: 64" "Scores >= 80: 5" "Median: 81.00")
    string(FIND "${output}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing ${expected} in ${output}")
    endif()
endforeach()
message(STATUS "Variant 02: all expected results verified")
